{
  "name": "kitsune-companion",
  "version": "1.0.0",
  "description": "Rin \u2014 a 3D fox-girl AI assistant for Windows, powered by Gemini via Google account sign-in.",
  "main": "./out/main/index.js",
  "author": "Kitsune Companion",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "assets:force": "node scripts/fetch-assets.mjs --force",
    "build": "npm run typecheck && electron-vite build",
    "build:mobile": "npm run typecheck && vite build --config vite.mobile.config.ts",
    "dev": "electron-vite dev",
    "open:android": "cap open android",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/fetch-assets.mjs --if-missing",
    "predev": "node scripts/ensure-electron.mjs",
    "prepackage:win": "node scripts/ensure-electron.mjs",
    "render": "node tools/render.mjs",
    "start": "electron-vite preview",
    "sync:android": "npm run build:mobile && cap sync android",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force tsconfig.json"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "dev.kitsune.companion",
    "productName": "Kitsune Companion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Kitsune Companion"
    }
  }
}
